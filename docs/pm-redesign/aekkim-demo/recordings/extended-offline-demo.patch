+package com.ssafy.e106.demo
+
+import com.ssafy.e106.data.repository.AnalysisHandoffRepository
+import com.ssafy.e106.feature.analysis.AnalysisPipelinePhase
+import com.ssafy.e106.feature.analysis.AnalysisPipelineSnapshot
+import com.ssafy.e106.feature.analysis.model.AnalysisSessionResult
+import com.ssafy.e106.feature.analysis.model.CandidateResolution
+import com.ssafy.e106.feature.analysis.model.ServiceCatalog
+import kotlinx.coroutines.delay
+
+/** Fixed recording fixtures, never real financial data or actual AI inference. */
+object DemoScreens {
+    var entryScreen: String? = null
+    val onboarding get() = entryScreen == "payments" || entryScreen == "analysis"
+
+    fun result(): AnalysisSessionResult {
+        val names = listOf("넷플릭스", "스포티파이", "ChatGPT", "웨이브", "티빙", "디즈니플러스")
+        val codes = listOf("NETFLIX", "SPOTIFY", "CHATGPT", "WAVVE", "TVING", "DISNEY_PLUS")
+        val prices = listOf(13500, 11900, 29000, 10900, 9500, 9900)
+        val catalog = ServiceCatalog(services = names.mapIndexed { index, name ->
+            ServiceCatalog.Service(serviceId = index + 1L, code = codes[index], name = name,
+                plans = listOf(ServiceCatalog.Plan(servicePlanId = (index + 1L) * 100,
+                    planName = "데모 요금제", billingCycle = "MONTHLY", monthlyPrice = prices[index])))
+        })
+        return AnalysisSessionResult(
+            sessionId = "offline-recording-demo", analyzedAtEpochMs = System.currentTimeMillis(),
+            source = AnalysisSessionResult.AnalysisSource.LEGACY_SEED, serviceCatalog = catalog,
+            resolutions = names.mapIndexed { index, name ->
+                val reviewNeeded = index == 3
+                CandidateResolution(reviewId = 9100L - index,
+                    decision = if (reviewNeeded) CandidateResolution.Decision.REVIEW_NEEDED
+                        else CandidateResolution.Decision.CONFIRMED_SUBSCRIPTION,
+                    resolutionSource = CandidateResolution.ResolutionSource.LEGACY_SEED,
+                    merchantRaw = if (reviewNeeded) "콘텐츠 정기결제" else name,
+                    monthlyAmount = prices[index], billedAtLabel = "9월 ${1 + index}일",
+                    serviceId = index + 1L, servicePlanId = (index + 1L) * 100,
+                    serviceName = name, highConfidence = !reviewNeeded,
+                    reasonCodes = listOf("OFFLINE_DEMO_FIXTURE"))
+            })
+    }
+
+    suspend fun runAnalysis(handoff: AnalysisHandoffRepository,
+        onPhase: suspend (AnalysisPipelinePhase) -> Unit): AnalysisPipelineSnapshot {
+        // Real UI state transitions with fixed demo outputs. No model is invoked.
+        for (phase in listOf(AnalysisPipelinePhase.PaymentBootstrap,
+            AnalysisPipelinePhase.Normalization, AnalysisPipelinePhase.AiResolver)) {
+            onPhase(phase)
+            delay(3000)
+        }
+        val result = result()
+        handoff.storeAnalysisSessionResult(result)
+        onPhase(AnalysisPipelinePhase.HandoffPersisted)
+        return AnalysisPipelineSnapshot(emptyList(), result.serviceCatalog!!, emptyList(), result, 4800)
+    }
+}
